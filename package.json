{
  "publisher": "Chandrashekar Talawar",
  "name": "smart-semicolon",
  "displayName": "Smart Semicolon",
  "description": "Smart semicolon insertion for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chandutalawar187-blip/smart-semicolon"
  },
  "icon": "assets/icon.png",
  "license":"MIT",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smart-semicolon.smartSemicolon",
        "title": "Smart Semicolon"
      }
    ],
    "keybindings": [
      {
        "command": "smart-semicolon.smartSemicolon",
        "key": "alt+;",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
